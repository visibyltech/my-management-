  "firestore": {
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/CompanySettings" },
      "description": "Company-wide configuration including Kuda Bank details, payment minimums, and commission settings."
    },
    "/staff/{uid}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Private staff records including PII and bank payout details."
    },
    "/staffPublic/{uid}": {
      "schema": { "$ref": "#/entities/StaffPublic" },
      "description": "Non-PII staff directory for assignment dropdowns."
    },
    "/staffInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/StaffInvite" },
      "description": "Pre-authorized staff invitations created by Super Admin."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer records with Customer ID and unique 10-digit Account Number."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Operational project records and statuses."
    },
    "/projects/{projectId}/deliverables/{deliverableId}": {
      "schema": { "$ref": "#/entities/ProjectDeliverable" },
      "description": "Completed work deliverables uploaded by assigned developers."
    },
    "/projectFinancials/{projectId}": {
      "schema": { "$ref": "#/entities/ProjectFinancial" },
      "description": "Confidential project pricing and balances restricted from developer accounts."
    },
    "/onboardingForms/{formId}": {
      "schema": { "$ref": "#/entities/OnboardingForm" },
      "description": "Private customer onboarding forms and uploaded assets."
    },
    "/invoices/{invoiceId}": {
      "schema": { "$ref": "#/entities/Invoice" },
      "description": "Corporate invoices generated for customers and projects."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Customer payment records pending or confirmed by Admin."
    },
    "/commissions/{commissionId}": {
      "schema": { "$ref": "#/entities/Commission" },
      "description": "Sales commission ledger entries."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Business expense records and receipts."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time operational notifications."
    },
    "/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Immutable activity and audit log."
    }
  }
}
