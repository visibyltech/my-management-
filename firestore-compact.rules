rules_version='2';service cloud.firestore {match /databases/{database}/documents {match /{document=**} {allow read,write:if false;} function isSignedIn() {return request.auth!=null&&request.auth.token.email_verified==true;} function authEmail() {return request.auth.token.email.lower();} function incoming() {return request.resource.data;} function existing() {return resource.data;} function isValidId(id) {return id is string&&id.size()>=1&&id.size()<=128&&id.matches('^[a-zA-Z0-9_\\-]+$');} function isOwner(uid) {return isSignedIn()&&request.auth.uid==uid;} function isBootstrappedSuperAdmin() {return isSignedIn()&&authEmail()=='visibyl.biz@gmail.com';} function staffDocExists() {return exists(/databases/$(database)/documents/staff/$(request.auth.uid));} function staffData() {return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data;} function isActiveStaff() {return isBootstrappedSuperAdmin()||(isSignedIn()&&staffDocExists()&&staffData().employmentStatus=='active');} function isSuperAdmin() {return isBootstrappedSuperAdmin()||(isActiveStaff()&&staffData().role=='super_admin');} function isAdmin() {return isSuperAdmin()||(isActiveStaff()&&staffData().role=='admin');} function isFinance() {return isAdmin()||(isActiveStaff()&&staffData().role=='finance');} function isSales() {return isActiveStaff()&&staffData().role=='sales';} function isSupport() {return isActiveStaff()&&staffData().role=='support';} function isDeveloper() {return isActiveStaff()&&staffData().role=='developer';} function isNonDevStaff() {return isAdmin()||isFinance()||isSales()||isSupport();} function isValidCompanySettings(data) {return data.keys().hasAll(['companyName','tagline','companyEmail','companyPhone','companyAddress','bankAccountName','bankName','bankAccountNumber','minimumPaymentAmount','commissionMode','defaultCommissionRate','defaultFixedCommission','departments','services','updatedByUid','updatedAt'])&&data.keys().hasOnly(['companyName','tagline','companyEmail','companyPh